modules = ["nodejs-24"]

run = "pnpm --filter @workspace/vexa-landing dev"

[deployment]
router = "static"
deploymentTarget = "autoscale"
rootDir = "artifacts/vexa-landing"
build = ["sh", "-c", "pnpm install && pnpm -r run build"]
run = ["sh", "-c", "pnpm --filter @workspace/vexa-landing serve"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
